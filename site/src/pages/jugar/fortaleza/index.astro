---
/**
 * THE FORTRESS'S PAGE (stage 5f, on the games' shell): the adventure, at night. The title, its three
 * levels, what each one took kept in this browser, the thread's lines and the credits. (The texts are
 * the site's, in Spanish.)
 */
import GameFrame from '../../../components/GameFrame.astro';

const play = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}jugar/`;
---

<GameFrame title="La fortaleza · Manifold Gaming" back={{ href: play, label: '← Salir de la fortaleza' }} hintKey="mg-fortress-hint-seen">
  <span slot="hint">
    <kbd>W</kbd>
    <kbd>A</kbd>
    <kbd>S</kbd>
    <kbd>D</kbd> o las flechas para caminar, <kbd>C</kbd> para agacharte (te ven y te oyen menos), <kbd>E</kbd> para apagar o prender un farol cercano, <kbd>X</kbd> o un clic para el palo (por la espalda, a un guardia que no te ve, lo voltea), <kbd>F</kbd> para tirar humo, <kbd>Z</kbd> una bengala y <kbd>Q</kbd> una piedrita (donde cae, un guardia va a mirar). Un guardia ve lo que está iluminado, pero tarda en darse cuenta: el círculo sobre su cabeza se llena (<b>?</b>, sospecha; <b>!</b>, te descubrió), y si salís de su vista antes, se le pasa. La gema abajo dice cuánto se te ve. <kbd>Esc</kbd> o <kbd>P</kbd>: pausa y ajustes.
  </span>
  <script>
    import { startFortress } from '@manifold/fortress';
    await startFortress(document.getElementById('game')!);
    window.dispatchEvent(new Event('mg-game-ready'));
    window.addEventListener('hashchange', () => location.reload());
  </script>
</GameFrame>
