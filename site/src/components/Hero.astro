---
/**
 * THE HOME PAGE'S HERO: it replaces Starlight's "Hero" (astro.config.mjs → components). It takes the
 * same from the page's frontmatter (`hero.title`, `hero.tagline`, `hero.actions`), and instead of an
 * image it shows the live 3D showcase.
 *
 * The <h1> keeps the id `_top` and `data-page-title`, like Starlight's: that is how the "back to
 * top" link and screen readers find it.
 *
 * (The texts are the site's, in Spanish.)
 */
import { LinkButton } from '@astrojs/starlight/components';
import Showcase from './Showcase.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
// "Manifold Gaming": the first word big; the rest below, spaced out.
const [first, ...rest] = title.split(' ');
---

<div class="hero">
  <script is:inline>
    // THE ENTRANCE: a moment long, and it never covers the page nor waits for a click. It plays when
    // the home page is opened or reloaded, not when coming back to it from another page of the site,
    // and never for someone who asked for less motion. It runs here, before the hero is parsed, so
    // nothing shows up first and then hides. Without JavaScript, everything is simply there.
    try {
      const nav = performance.getEntriesByType('navigation')[0];
      const fromSite = document.referrer.startsWith(location.origin) && (!nav || nav.type !== 'reload');
      if (!fromSite && !matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.setAttribute('data-mg-intro', '');
    } catch {}
  </script>
  <div class="hero-text">
    <p class="hero-kicker">Laboratorio de mundos físicos en 3D</p>
    <h1 id="_top" data-page-title>
      <span class="hero-title-1">{first}</span>
      {rest.length > 0 && <span class="hero-title-2">{rest.join(' ')}</span>}
    </h1>
    <svg class="hero-ornament" viewBox="0 0 260 18" aria-hidden="true">
      <path class="ornament-line" d="M0 9H104M156 9H260M112 9h-4M152 9h-4M120 9h-3M143 9h-3" />
      <circle class="ornament-ring" cx="130" cy="9" r="7" pathLength="1" />
      <circle class="ornament-ring ornament-ring-inner" cx="130" cy="9" r="2.2" pathLength="1" />
      <path class="ornament-tick" d="M130 0v4M130 14v4" />
    </svg>
    {tagline && <div class="hero-tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="hero-actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>
  <Showcase />
</div>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: 1.5rem 3rem;
  }
  @media (min-width: 62rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 3.5rem;
      padding-block: 3.5rem 4.5rem;
    }
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    align-items: center;
    text-align: center;
  }
  @media (min-width: 62rem) {
    .hero-text {
      align-items: flex-start;
      text-align: start;
    }
  }

  .hero-kicker {
    margin: 0;
    font-family: var(--mg-font-title);
    font-size: clamp(0.68rem, 0.6rem + 0.3vw, 0.8rem);
    font-weight: 600;
    letter-spacing: clamp(0.1em, 0.03em + 0.6vw, 0.22em);
    text-transform: uppercase;
    color: var(--sl-color-accent-high);
  }

  /* The title: embossed bronze letters (the gradient is clipped to the letter; the shadow lifts it). */
  h1 {
    /* The first word's size; the second is a fixed fraction, so the proportion does not change. */
    --t: clamp(2.7rem, 1.4rem + 5vw, 4.6rem);
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: inherit;
    font-family: var(--mg-font-title);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    filter: drop-shadow(0 2px 0 rgb(30 18 8 / 0.9)) drop-shadow(0 10px 18px rgb(0 0 0 / 0.55));
  }
  :global([data-theme='light']) h1 {
    filter: drop-shadow(0 1px 0 rgb(255 250 240 / 0.9)) drop-shadow(0 6px 12px rgb(80 50 20 / 0.25));
  }
  /* The letters: old metal, with rust stains in the stroke. */
  h1 span {
    background: var(--mg-rust), var(--mg-metal-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-title-1 {
    font-size: var(--t);
    letter-spacing: 0.03em;
  }
  .hero-title-2 {
    margin-top: 0.3em;
    font-size: calc(var(--t) * 0.42);
    /* Spaced so that "GAMING" takes the width of "MANIFOLD" (measured in the browser). The last
       letter does not need its space: the negative margin makes up for it. */
    letter-spacing: 1.85em;
    margin-inline-end: -1.85em;
  }

  .hero-ornament {
    width: 15rem;
    height: auto;
    fill: none;
    stroke: var(--mg-bronze-line-strong);
    stroke-width: 1.2;
  }

  .hero-tagline {
    max-width: 36rem;
    font-family: var(--mg-font-book);
    font-size: clamp(1.02rem, 0.95rem + 0.35vw, 1.17rem);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  /* The main action and the secondary one, side by side (one above the other if there is no room). */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1rem;
    justify-content: center;
    margin-top: 0.4rem;
  }
  @media (min-width: 62rem) {
    .hero-actions {
      justify-content: flex-start;
    }
  }
  /* The secondary buttons: patina plates, quieter than the bronze one. */
  .hero-actions :global(.sl-link-button.minimal) {
    padding: 0.9rem 1.2rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent-high) 45%, transparent);
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
    color: var(--sl-color-accent-high);
    font-family: var(--mg-font-title);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .hero-actions :global(.sl-link-button.minimal:hover) {
    background: color-mix(in srgb, var(--sl-color-accent) 20%, transparent);
    color: var(--sl-color-white);
  }

  /* ---------- The entrance (the script above turns it on) ----------
     In order, in about two seconds: the kicker is uncovered from left to right; MANIFOLD comes out of
     the blur and a gleam crosses the metal; GAMING opens its letters; the compass draws its circles
     and the rule grows from its center; then the text, the buttons, the showcase and the doors
     (HomeDoors.astro). The keyframes say only where each one starts: it ends as it is anyway. (The
     kicker is uncovered and not spaced out: spaced out, it took two lines and pushed the title down.) */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-mg-intro]) .hero-kicker {
      /* `backwards`: once uncovered, no clip is left on it. */
      animation: mg-uncover 0.9s 0.05s backwards cubic-bezier(0.4, 0, 0.2, 1);
    }
    :global(html[data-mg-intro]) .hero-title-1 {
      /* A gleam over the metal: one more layer, a light band that crosses the letters once. */
      background:
        linear-gradient(100deg, transparent 38%, rgb(255 236 200 / 0.75) 50%, transparent 62%) 85% 0 / 300% 100% no-repeat,
        var(--mg-rust),
        var(--mg-metal-text);
      -webkit-background-clip: text;
      background-clip: text;
      animation:
        mg-emerge 1s 0.1s both cubic-bezier(0.16, 0.8, 0.24, 1),
        mg-gleam 1.2s 0.6s both ease-in-out;
    }
    :global(html[data-mg-intro]) .hero-title-2 {
      animation: mg-unfold 1.2s 0.35s both cubic-bezier(0.16, 0.8, 0.24, 1);
    }
    :global(html[data-mg-intro]) .ornament-ring {
      stroke-dasharray: 1;
      animation: mg-draw 0.8s 0.45s both ease-out;
    }
    :global(html[data-mg-intro]) .ornament-ring-inner {
      animation-delay: 0.65s;
    }
    :global(html[data-mg-intro]) .ornament-line {
      transform-box: fill-box;
      transform-origin: center;
      animation: mg-grow 0.9s 0.7s both cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    :global(html[data-mg-intro]) .ornament-tick {
      animation: mg-fade 0.5s 0.95s both;
    }
    :global(html[data-mg-intro]) .hero-tagline {
      animation: mg-rise 0.8s 0.8s both cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    :global(html[data-mg-intro]) .hero-actions {
      animation: mg-rise 0.8s 0.95s both cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    :global(html[data-mg-intro]) .hero :global(.showcase) {
      animation: mg-frame 1.2s 0.25s both cubic-bezier(0.16, 0.8, 0.24, 1);
    }
  }

  @keyframes mg-rise {
    from {
      opacity: 0;
      transform: translateY(0.9rem);
    }
  }
  @keyframes mg-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes mg-uncover {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes mg-emerge {
    from {
      opacity: 0;
      transform: translateY(0.18em) scale(0.97);
      filter: blur(8px);
    }
  }
  /* The band goes from the left of the letters (85%) to past their right (15%): its image is three
     times as wide as the word. The other two layers stay where they are. */
  @keyframes mg-gleam {
    from {
      background-position:
        85% 0,
        0 0,
        0 0;
    }
    to {
      background-position:
        15% 0,
        0 0,
        0 0;
    }
  }
  @keyframes mg-unfold {
    from {
      opacity: 0;
      letter-spacing: 0.3em;
      margin-inline-end: -0.3em;
    }
  }
  @keyframes mg-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes mg-grow {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
  }
  @keyframes mg-frame {
    from {
      opacity: 0;
      transform: translateY(1rem) scale(0.985);
    }
  }
</style>
