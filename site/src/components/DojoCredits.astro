---
/**
 * WHERE WHAT IS SEEN COMES FROM (stage 2e, decision 0015): the Dojo's art files, from their list
 * (`games/dojo/assets/assets.json`, and the characters' in `packages/character/assets/`, which tests keep whole). Made by a script of the repository, or
 * from outside with its author, its source and its license. The texts are the site's, in Spanish.
 */
import list from '@manifold/dojo/assets';
// The games' character (stage 4a), which the Dojo draws too.
import characters from '@manifold/character/assets';

const entries = Object.entries({ ...characters, ...list } as Record<
  string,
  { madeBy?: string; source?: string; author?: string; license?: string }
>);
const repository = 'https://github.com/RodrigoMartinVG/Manifold_Gaming/blob/main/';
---

<table>
  <thead>
    <tr>
      <th>Archivo</th>
      <th>De dónde sale</th>
    </tr>
  </thead>
  <tbody>
    {
      entries.map(([file, e]) => (
        <tr data-asset={file}>
          <td>
            <code>{file}</code>
          </td>
          <td>
            {e.madeBy ? (
              <>
                lo hace un guion de este repositorio, <a href={repository + e.madeBy}>{e.madeBy}</a>, corriendo Blender sin pantalla
              </>
            ) : (
              <>
                de {e.author} (<a href={e.source}>{e.source}</a>), con licencia {e.license}
              </>
            )}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
