---
/**
 * THE DOJO'S PAGE: full screen, in a game's frame (GameFrame). Two pages use it: `/jugar/dojo/` and
 * each saved room's (`/jugar/dojo/rain/`), which passes its name (decision 0010: every room has its
 * address). Astro bundles the <script> with Vite, like any page: it imports the Dojo as one more
 * package of the monorepo.
 *
 * The first time, a hint says how to start: the console is the Dojo's whole interface, and without
 * the hint all one sees is a cube. Leaving goes to the Dojo's page in the site (`/jugar/dojo/`).
 * (The texts are the site's, in Spanish.)
 */
import GameFrame from './GameFrame.astro';

interface Props {
  /** The saved room (its recipe's name), if one came in through its address. */
  room?: string;
  /** Its title, for the browser tab. */
  title?: string;
  /** Whether it has a character to drive: then the hint also says how. */
  character?: boolean;
}
const { room, title, character = false } = Astro.props;
const play = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}jugar/dojo/`;
---

<GameFrame
  title={title ? `${title} · Dojo · Manifold Gaming` : 'Dojo · Manifold Gaming'}
  back={{ href: play, label: '← Salir del Dojo' }}
  hintKey={character ? 'mg-dojo-hint-character-seen' : 'mg-dojo-hint-seen'}
  room={room}
>
  <Fragment slot="hint">
        {
          character ? (
            <span>
              <kbd>W</kbd>
              <kbd>A</kbd>
              <kbd>S</kbd>
              <kbd>D</kbd> o las flechas para caminar, <kbd>Espacio</kbd> para saltar, <kbd>Shift</kbd> para correr,{' '}
              <kbd>C</kbd> para agacharse, <kbd>V</kbd> para rodar, <kbd>E</kbd> para apretar un botón y <kbd>F</kbd> para tirar una pelota (más tiempo apretada, más lejos), <kbd>X</kbd> o el clic para usar un arma, <kbd>B</kbd> para bloquear, <kbd>T</kbd> para fijarte en alguien; arrastrá para girar la cámara.{' '}
              <kbd>Esc</kbd> o <kbd>P</kbd>: pausa y ajustes. Lo demás, desde la consola: abrila con{' '}
              <kbd>º</kbd> o con el botón <code>›_</code>, y probá <code>help</code>.
            </span>
          ) : (
            <span>
              Arrastrá para mirar alrededor, y hacé clic en algo para inspeccionarlo. Lo demás se maneja desde la consola:
              abrila con <kbd>º</kbd> o con el botón <code>›_</code>, y probá <code>help</code>.
            </span>
          )
        }
  </Fragment>
  <script>
    import { startDojo } from '@manifold/dojo';
    const game = document.getElementById('game')!;
    await startDojo(game, { room: game.dataset.room, base: import.meta.env.BASE_URL });
    window.dispatchEvent(new Event('mg-game-ready'));
    // A link to this same page with another fragment (a recipe, a replay, a ghost) does not open the
    // page again: the browser only changes the fragment. The world must be born from it: start over.
    window.addEventListener('hashchange', () => location.reload());
  </script>
</GameFrame>
