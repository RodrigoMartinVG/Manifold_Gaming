signal never
signal key_yellow
signal at_yellow  zone yellow_front
signal yellow_both  all key_yellow at_yellow
signal yellow_open  latch yellow_both never
signal secret_pressed  used secret_button
signal secret_open  latch secret_pressed never
box 0 1.5 -25.5  1 1.5 0.15  door -1 0 0 y 90 1 yellow_open  color #c8a83a  name yellow_door
box -16 1.5 -22.5  1 1.5 0.15  door -1 0 0 y 90 1 secret_open  color #6a645c  name secret_door

lamp 0 2.6 -1.4  4 1  name lamp_start
lamp 0 2.6 -14  6 1  name lamp_yard
lamp -17 2.6 -16  4 0.9  name lamp_west
lamp 17 2.6 -16  4 0.9  name lamp_east
lamp 0 2.6 -33  6 1  name lamp_hall

sensor area        0 1 -23.5     1.5 0.8 1.5  name yellow_front
sensor area        -16 1 -20.5   0.5 0.8 0.5  name secret_button
sensor checkpoint  0 1 0         2 0.8 1
sensor checkpoint  0 1 -21       2 0.8 1.5
sensor weapon      -19 0.5 -12   0.4 0.5 0.4  kind 2
sensor ammo        -19 1 -20     0.3 0.4 0.3  kind 5  amount 4
sensor ammo        -15 1 -12     0.3 0.4 0.3  kind 3  amount 10
sensor key         19 1 -19      0.3 0.6 0.3  color 3
sensor health      17 1 -11      0.3 0.4 0.3  amount 25
sensor health      -6 1 -1       0.3 0.4 0.3  amount 25
sensor ammo        6 1 -1        0.3 0.4 0.3  kind 1  amount 40
sensor armor       -15 1 -24.4   0.4 0.6 0.4  amount 50
sensor ammo        -13.5 1 -23.5 0.3 0.4 0.3  kind 2  amount 12
sensor secret      -15.5 1 -24   1.5 0.8 1
sensor attackers   0 1 -21       0.4 0.8 0.4  wave 0  count 2  role 1  rotate y 180
sensor attackers   6 1 -22       0.4 0.8 0.4  wave 0  count 1  role 2  rotate y 180
sensor attackers   -18 1 -15     0.4 0.8 0.4  wave 0  count 1  role 1  rotate y -90
sensor trigger     15 1 -16      1 0.8 1.5  wave 1
sensor attackers   0 1 -23       0.4 0.8 0.4  wave 1  count 2  role 3
