signal barracks_lift_up  zone barracks_lift_ride

# The yard: a stair up to each balcony, and a bridge between them 3 m up.
kit stairs_3  -13 0 -10
kit stairs_3  12 0 -10
kit bridge_4  -10 3 -18  rotate y 90
kit bridge_4  -6 3 -18  rotate y 90
kit bridge_4  -2 3 -18  rotate y 90
kit bridge_4  2 3 -18  rotate y 90
kit bridge_4  6 3 -18  rotate y 90
kit bridge_4  10 3 -18  rotate y 90

# The barracks’ lift, to the armory: stepped off above, it goes back down.
box -6 0.15 -26  1 0.15 1  lift 0 2.7 0 2.5 barracks_lift_up  color #7a5a3a  name barracks_lift

# The bridge over the inner court, from the armory to the tower’s dais, 3 m up.
kit bridge_4  -2 3 -30  rotate y 90
kit bridge_4  2 3 -30  rotate y 90
kit bridge_4  6 3 -30  rotate y 90

# The round tower: its wall, a door south, west (the bridge above it) and north (the red door).
