signal never
signal key_red
signal key_blue
signal at_blue  zone blue_front
signal at_red  zone red_front
signal blue_both  all key_blue at_blue
signal red_both  all key_red at_red
signal blue_open  latch blue_both never
signal red_open  latch red_both never
signal secret_pressed  used secret_button
signal secret_open  latch secret_pressed never
box 0 1.5 -19.5  1 1.5 0.15  door -1 0 0 y 90 1 blue_open  color #3a6ab0  name blue_door
box 0 1.5 -33.5  1 1.5 0.15  door -1 0 0 y 90 1 red_open  color #b04a3a  name red_door
box -15.5 1.5 -5  0.15 1.5 1  door 0 0 1 y 90 1 secret_open  color #6a645c  name secret_door

lamp 0 2.6 -1.4  4 1  name lamp_start
lamp -5 2.6 -10  5 1  name lamp_hall_west
lamp 4 2.6 -16  5 1  name lamp_hall_east
lamp -16 2.6 -14  4 0.9  name lamp_west
lamp 16 2.6 -14  4 0.9  name lamp_east
lamp 0 2.6 -27  6 1  name lamp_court
lamp 0 2.6 -37  4 1  name lamp_way

