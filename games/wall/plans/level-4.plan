signal never
signal key_red
signal at_red  zone red_front
signal red_both  all key_red at_red
signal red_open  latch red_both never
signal secret_pressed  used secret_button
signal secret_open  latch secret_pressed never
box 0 1.5 -23.5  1 1.5 0.15  door -1 0 0 y 90 1 red_open  color #b04a3a  name red_door
box -16 1.5 -11.5  1 1.5 0.15  door -1 0 0 y 90 1 secret_open  color #6a645c  name secret_door

lamp 0 2.6 -6  5 1  name lamp_hall
