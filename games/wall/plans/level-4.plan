# The hall’s columns; the armory’s shelf on its column, and the two blocks up to it.
kit column  -6 0 -9
kit column  -6 0 -13
kit column  -6 0 -17
kit column  6 0 -9
kit column  6 0 -13
kit column  6 0 -17
kit column  -20.3 0 -15.3
kit platform_2  -17 0 -17
kit platform_2  -19 0 -17
kit platform_2  -19 1 -17

# The court: the stairs up to the ramparts, and the ferry across the west one’s break.
kit stairs_3  -23 0 -25
kit stairs_3  22 0 -25
box -22.5 2.85 -33  1.5 0.15 1  move 0 0 -4 3  color #7a5a3a  name ferry

# The platform that goes up and down, from the gatehouse’s upper floor to the winch room.
box 0 2.85 -55  1 0.15 1  move 0 3 0 3  color #7a5a3a  name hoist

