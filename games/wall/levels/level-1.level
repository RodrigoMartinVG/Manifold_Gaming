# Their ways in: from the gate, out to the west, the middle and the east, and back.
route in_west  -1.4 0 -27  -1 0 -20  -7 0 -6
route in_mid   0 0 -28     0 0 -20  0 0 -9
route in_east  1.4 0 -27   1 0 -20  7 0 -6

