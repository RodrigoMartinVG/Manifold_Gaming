box 20.65 1.25 24   0.25 1.25 2   color #5a544c  name corridor_080

# Ceilings over the floor, 2 m deep: 0.95 to 1.7 m high.
box 4 1.2 16   1.5 0.25 1   color #5a544c  name ceiling_095
box 8 1.3 16   1.5 0.25 1   color #5a544c  name ceiling_105
box 12 1.4 16   1.5 0.25 1   color #5a544c  name ceiling_115
box 16 1.85 16   1.5 0.25 1   color #5a544c  name ceiling_160
box 20 1.9 16   1.5 0.25 1   color #5a544c  name ceiling_165
box 24 1.95 16   1.5 0.25 1   color #5a544c  name ceiling_170

