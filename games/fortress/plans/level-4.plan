# The flame's pedestal.
kit platform_2  0 0 -38

lamp -6 2.4 -14  4 1  name lantern_hall_west
lamp 5 2.4 -22  4 1  name lantern_hall_east
lamp 12.5 2.4 -20  4 1  name lantern_aisle_east
lamp -12.5 2.4 -4  3.5 0.9  name lantern_postern

route aisle  12.5 0 -8  12.5 0 -42
route hall loop  -3 0 -8  3 0 -8  3 0 -26  -3 0 -26

sensor post        0 1 -31.5     0.4 0.8 0.4  rotate y 180
sensor guard       12.5 1 -8     0.4 0.8 0.4
sensor guard       -3 1 -8       0.4 0.8 0.4  rotate y -90
sensor relic       0 1.2 -37.6   1.2 0.6 1.3
sensor checkpoint  0 1 -3        2 0.8 1
sensor checkpoint  12.5 1 -38    1.5 0.8 1.5
sensor item        -13 1 -8      0.4 0.4 0.4  kind 1
sensor item        -13 1 -20     0.4 0.4 0.4  kind 3
sensor scroll      -13.5 1 -43   0.4 0.6 0.4
sensor scroll      14.5 1 -43.5  0.4 0.6 0.4
sensor goal        -15.5 1 -2    0.6 0.8 1
sensor fall        0 -10 0       80 2 80
