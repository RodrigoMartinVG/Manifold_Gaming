lamp -10.5 2.4 -10.5  4 1  name lantern_corridor_sw
lamp 10.5 2.4 -29.5  4 1  name lantern_corridor_ne
lamp 0 2.4 -24  5 1  name lantern_hall
lamp -14.5 2.4 -8  3.5 0.8  name lamp_room_sw
lamp 14.5 2.4 -20  3.5 0.8  name lamp_room_e
lamp -2 2.4 -38.6  4 1  name lantern_way_west
lamp 2 2.4 -38.6  4 1  name lantern_way_east

route round loop  -10.5 0 -7.5  10.5 0 -7.5  10.5 0 -32.5  -10.5 0 -32.5

sensor guard       -10.5 1 -7.5  0.4 0.8 0.4  rotate y -90
sensor post        0 1 -19       0.4 0.8 0.4  rotate y 180
sensor checkpoint  0 1 -3        2 0.8 1
sensor checkpoint  -15 1 -33     1.5 0.8 1.5
sensor item        -15 1 -5      0.4 0.4 0.4  kind 1
sensor item        15 1 -18      0.4 0.4 0.4  kind 3
sensor scroll      -15.5 1 -37   0.4 0.6 0.4
sensor scroll      0.5 1 -29     0.4 0.6 0.4
sensor goal        0 1 -37       3 0.8 1.5
sensor fall        0 -10 0       80 2 80
