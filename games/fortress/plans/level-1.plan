lamp -3 2.4 -1.4  5 1  name lantern_breach
lamp -2 2.4 -9  5 1  name lantern_yard
lamp -2.6 2.4 -17.2  4 1  name lantern_gate_west
lamp 1.6 2.4 -17.2  4 1  name lantern_gate_east

route yard  -14 0 -7  6 0 -7

sensor guard       -14 1 -7      0.4 0.8 0.4  rotate y -90
sensor post        -0.5 1 -16    0.4 0.8 0.4  rotate y 180
sensor checkpoint  -3 1 -2.5     1.5 0.8 1
sensor checkpoint  17.5 1 -2.5   1 0.8 1
sensor item        2 1 6         0.4 0.4 0.4  kind 1
sensor item        17.5 1 -9     0.4 0.4 0.4  kind 3
sensor scroll      12.5 1 -12    0.4 0.6 0.4
sensor scroll      -17.5 1 -15.5 0.4 0.6 0.4
sensor goal        -0.5 1 -22    3 0.8 2
sensor fall        0 -10 0       80 2 80
