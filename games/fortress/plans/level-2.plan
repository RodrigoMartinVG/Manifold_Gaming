# The deck, a meter up, and its ramp from the south.
kit platform_2  -19 0 -27
kit platform_2  -17 0 -27
kit platform_2  -19 0 -29
kit platform_2  -17 0 -29
kit ramp_1  -18 0 -24

lamp -7.4 2.4 -9  5 1  name lantern_stable_sw
lamp 6.4 2.4 -21  5 1  name lantern_stable_ne
lamp 14 2.4 -16  5 1  name lantern_well
lamp -2.6 2.4 -31.2  4 1  name lantern_door_west
lamp 1.6 2.4 -31.2  4 1  name lantern_door_east

route round loop  -9 0 -7  9 0 -7  9 0 -23  -9 0 -23
route east  16 0 -4  16 0 -28

sensor guard       -9 1 -7       0.4 0.8 0.4  rotate y -90
sensor guard       16 1 -4       0.4 0.8 0.4  rotate y 180
sensor post        -0.5 1 -29.5  0.4 0.8 0.4  rotate y 180
sensor checkpoint  0 1 0         2 0.8 1.5
sensor checkpoint  -18 1 -19     1.5 0.8 1.5
sensor item        -20 1 -2      0.4 0.4 0.4  kind 1
sensor item        20 1 -30      0.4 0.4 0.4  kind 3
sensor scroll      -18 2 -28.5   0.4 0.6 0.4
sensor scroll      0.5 1 -12     0.4 0.6 0.4
sensor goal        -0.5 1 -36    3 0.8 2
sensor fall        0 -10 0       80 2 80
