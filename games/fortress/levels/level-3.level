# The flame's pedestal, between two pillars.
kit pillar  -3 0 -18
kit pillar  3 0 -18
kit platform_2  0 0 -18.6

route passage  8 0 -12  8 0 -32

# The guard at its post, facing the flame (its back to the hall); the other on its round.
sensor post        0 1 -15       0.4 0.8 0.4
sensor guard       8 1 -32       0.4 0.8 0.4  rotate y 180
# The flame: taken within reach of it (its zone wider than it, over the pedestal's front).
sensor relic       0 1.2 -18.4   1.2 0.6 1.3
sensor checkpoint  0 1 -2        2 0.8 1.5
sensor goal        12 1 -11      1.6 0.8 2.6
sensor fall        0 -10 0       80 2 80
