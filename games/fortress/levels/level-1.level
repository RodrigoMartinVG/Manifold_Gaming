# Manifold level 10
# The fortress's outer wall (stage 5f): the first level, the dark as cover. Through a breach in the
# outer wall, where a lantern lights the way in (put it out: a hand, `use`); across a yard a guard
# keeps to, back and forth; to the inner gate, a lantern by it too. Night: an ambient of 0.12, and a
# guard sees what is lit with 0.3 (a lamp gives its intensity times 1 - d/r). A smoke in a corner.
title The outer wall
spawn 0 1 7
facing 0 0 -1
ambient 0.12
sky 22.0

# The ground.
kit floor_4  -10 0 -22
kit floor_4  -6 0 -22
kit floor_4  -2 0 -22
kit floor_4  2 0 -22
kit floor_4  6 0 -22
kit floor_4  10 0 -22
kit floor_4  -10 0 -18
kit floor_4  -6 0 -18
kit floor_4  -2 0 -18
kit floor_4  2 0 -18
kit floor_4  6 0 -18
kit floor_4  10 0 -18
kit floor_4  -10 0 -14
kit floor_4  -6 0 -14
kit floor_4  -2 0 -14
kit floor_4  2 0 -14
kit floor_4  6 0 -14
kit floor_4  10 0 -14
kit floor_4  -10 0 -10
kit floor_4  -6 0 -10
kit floor_4  -2 0 -10
kit floor_4  2 0 -10
kit floor_4  6 0 -10
kit floor_4  10 0 -10
kit floor_4  -10 0 -6
kit floor_4  -6 0 -6
kit floor_4  -2 0 -6
kit floor_4  2 0 -6
kit floor_4  6 0 -6
kit floor_4  10 0 -6
kit floor_4  -10 0 -2
kit floor_4  -6 0 -2
kit floor_4  -2 0 -2
kit floor_4  2 0 -2
kit floor_4  6 0 -2
kit floor_4  10 0 -2
kit floor_4  -10 0 2
kit floor_4  -6 0 2
kit floor_4  -2 0 2
kit floor_4  2 0 2
kit floor_4  6 0 2
kit floor_4  10 0 2
kit floor_4  -10 0 6
kit floor_4  -6 0 6
kit floor_4  -2 0 6
kit floor_4  2 0 6
kit floor_4  6 0 6
kit floor_4  10 0 6
kit floor_2  -11 0 9
kit floor_2  -9 0 9
kit floor_2  -7 0 9
kit floor_2  -5 0 9
kit floor_2  -3 0 9
kit floor_2  -1 0 9
kit floor_2  1 0 9
kit floor_2  3 0 9
kit floor_2  5 0 9
kit floor_2  7 0 9
kit floor_2  9 0 9
kit floor_2  11 0 9

# The outer wall, 6 m high, a breach 4 m wide in its middle.
kit wall_4  -10 0 0.15
kit wall_4  -6 0 0.15
kit wall_2  -3 0 0.15
kit wall_4  -10 3 0.15
kit wall_4  -6 3 0.15
kit wall_2  -3 3 0.15
kit wall_4  4 0 0.15
kit wall_4  8 0 0.15
kit wall_2  11 0 0.15
kit wall_4  4 3 0.15
kit wall_4  8 3 0.15
kit wall_2  11 3 0.15

# The yard's sides; the inner wall, its gate 4 m wide and 3 high.
kit wall_4  -11.85 0 -14  rotate y 90
kit wall_4  -11.85 0 -10  rotate y 90
kit wall_4  -11.85 0 -6  rotate y 90
kit wall_4  -11.85 0 -2  rotate y 90
kit wall_4  -11.85 3 -14  rotate y 90
kit wall_4  -11.85 3 -10  rotate y 90
kit wall_4  -11.85 3 -6  rotate y 90
kit wall_4  -11.85 3 -2  rotate y 90
kit wall_4  11.85 0 -14  rotate y 90
kit wall_4  11.85 0 -10  rotate y 90
kit wall_4  11.85 0 -6  rotate y 90
kit wall_4  11.85 0 -2  rotate y 90
kit wall_4  11.85 3 -14  rotate y 90
kit wall_4  11.85 3 -10  rotate y 90
kit wall_4  11.85 3 -6  rotate y 90
kit wall_4  11.85 3 -2  rotate y 90
kit wall_4  -10 0 -16.15
kit wall_4  -6 0 -16.15
kit wall_2  -3 0 -16.15
kit wall_4  -10 3 -16.15
kit wall_4  -6 3 -16.15
kit wall_2  -3 3 -16.15
kit wall_4  4 0 -16.15
kit wall_4  8 0 -16.15
kit wall_2  11 0 -16.15
kit wall_4  4 3 -16.15
kit wall_4  8 3 -16.15
kit wall_2  11 3 -16.15
kit wall_4  0 3 -16.15

# Past the gate: the way on, walled.
kit wall_4  -5.85 0 -22  rotate y 90
kit wall_4  -5.85 0 -18  rotate y 90
kit wall_4  -5.85 3 -22  rotate y 90
kit wall_4  -5.85 3 -18  rotate y 90
kit wall_4  5.85 0 -22  rotate y 90
kit wall_4  5.85 0 -18  rotate y 90
kit wall_4  5.85 3 -22  rotate y 90
kit wall_4  5.85 3 -18  rotate y 90
kit wall_4  -4 0 -23.85
kit wall_4  0 0 -23.85
kit wall_4  4 0 -23.85
kit wall_4  -4 3 -23.85
kit wall_4  0 3 -23.85
kit wall_4  4 3 -23.85

# The lanterns: by the breach, inside; by the gate.
lamp -2.6 2.4 -0.8  5 1  name lantern_breach
lamp 2.4 2.4 -15.4  4.5 1  name lantern_gate

# The guard's round, back and forth across the yard, 5 m in.
route yard  -7 0 -5  7 0 -5

sensor guard       -7 1 -5       0.4 0.8 0.4  rotate y -90
sensor checkpoint  0 1 -2        2 0.8 1.5
sensor item        9 1 -3        0.4 0.4 0.4  kind 1
sensor goal        0 1 -20       2 0.8 2
sensor fall        0 -10 0       80 2 80
