kit wall_4  9.15 9 4  rotate y 90
kit floor_4  7 0 8
kit platform_2  9 15 -33
kit platform_2  9 16 -33
kit platform_2  9 17 -33
lamp 0 11 -8  7 1
lamp 0 17 -25  7 1
lamp 0 21 -33  8 1.2

# The land, far below; falling, back to the last checkpoint.
box 0 -40.5 -10   160 0.5 160   color #3d4a36  name land
sensor fall  0 -10 -10   80 2 80
sensor checkpoint  0 9.8 -8      4 0.8 2
sensor checkpoint  0 15.8 -25    4 0.8 2
sensor goal        0 18.8 -33    4 0.8 2
sensor star        7 11.4 4      1 0.8 1.6
sensor star        0 17.6 -22    0.6 0.6 0.6
sensor star        9 18.8 -33    0.6 0.8 0.6
