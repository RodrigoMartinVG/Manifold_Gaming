# Manifold level 10
# The tower's top (stage 5d): the fourth beat, mastered, as the light goes. A ledge 3 m up; a chimney
# 3 m wide up 6 m; a ferry to a landing, a lift from it (waited for there: the two do not keep time
# with each other); and the last chimney, 3.6 m wide (up to 4), up to the top,
# 18 m up, the goal. Stars: at the top of a chimney 4 m wide (the widest it climbs); over the lift's
# top; and on a pillar a running jump off the top (5 m).
title The top
spawn 0 1 7
facing 0 0 -1
ambient 0.45
sky 19.7

# The start, a balcony.
kit floor_4  -2 0 4
kit floor_4  2 0 4
kit floor_4  -2 0 8
kit floor_4  2 0 8

# A ledge 3 m up; on it, chimney 1, 3 m wide, up 6 m; terrace B, 9 m up.
kit wall_4  -2 -3 1.85
kit wall_4  2 -3 1.85
kit wall_4  -2 0 1.85
kit wall_4  2 0 1.85
kit wall_4  -2 -3 -5.85
kit wall_4  2 -3 -5.85
kit wall_4  -2 0 -5.85
kit wall_4  2 0 -5.85
kit wall_4  3.85 -3 -4  rotate y 90
kit wall_4  3.85 -3 0  rotate y 90
kit wall_4  3.85 0 -4  rotate y 90
kit wall_4  3.85 0 0  rotate y 90
kit wall_4  -3.85 -3 -4  rotate y 90
kit wall_4  -3.85 -3 0  rotate y 90
kit wall_4  -3.85 0 -4  rotate y 90
kit wall_4  -3.85 0 0  rotate y 90
kit floor_4  -2 3 -4
kit floor_4  2 3 -4
kit floor_4  -2 3 0
kit floor_4  2 3 0
kit wall_4  -1.65 3 -4  rotate y 90
kit wall_4  -1.65 6 -4  rotate y 90
kit wall_4  1.65 3 -4  rotate y 90
kit wall_4  1.65 6 -4  rotate y 90
kit wall_4  -2 0 -6.15
kit wall_4  2 0 -6.15
kit wall_4  -2 3 -6.15
kit wall_4  2 3 -6.15
kit wall_4  -2 6 -6.15
kit wall_4  2 6 -6.15
kit wall_4  -2 0 -9.85
kit wall_4  2 0 -9.85
kit wall_4  -2 3 -9.85
kit wall_4  2 3 -9.85
kit wall_4  -2 6 -9.85
kit wall_4  2 6 -9.85
kit wall_4  3.85 0 -8  rotate y 90
kit wall_4  3.85 3 -8  rotate y 90
kit wall_4  3.85 6 -8  rotate y 90
kit wall_4  -3.85 0 -8  rotate y 90
kit wall_4  -3.85 3 -8  rotate y 90
kit wall_4  -3.85 6 -8  rotate y 90
kit floor_4  -2 9 -8
kit floor_4  2 9 -8

# The ferry, off terrace B, 6 m in 3 s, to a landing; from it, the lift: from 9 m up to 15, in 3 s.
box 0 8.85 -11.5   1 0.15 1   move 0 0 -6 3   color #7a5a3a  name ferry
kit platform_2  0 8 -19.5
box 0 8.85 -22   1 0.15 1   move 0 6 0 3   color #7a5a3a  name lift

# The last chimney, 3.6 m wide, on a terrace 15 m up, past the top's face; the top, 18 m up.
kit wall_4  -2 9 -23.15
kit wall_4  2 9 -23.15
kit wall_4  -2 12 -23.15
kit wall_4  2 12 -23.15
kit wall_4  -2 9 -30.85
kit wall_4  2 9 -30.85
kit wall_4  -2 12 -30.85
kit wall_4  2 12 -30.85
kit wall_4  3.85 9 -29  rotate y 90
kit wall_4  3.85 9 -25  rotate y 90
kit wall_4  3.85 12 -29  rotate y 90
kit wall_4  3.85 12 -25  rotate y 90
