# Manifold level 10
# The tower's third floor (stage 5p, decision 0031: floors as rhythm, each one idea taught, developed, twisted
# and concluded): what turns. A carousel 4 m across, turning 30° a second, a jump off the balcony; off it, a
# landing. A second, faster (60°) and a meter up; a landing a meter higher. A bar 10 m long turning 30° a
# second (twelve seconds round): stepped onto at its end as it points this way, ridden half a turn, stepped off
# at the other side. Three small turntables, each a meter higher, quick (90°), up to the goal 6 m up, its
# beacon lit from the start. Stars: on a platform off the first landing, a carousel's jump away; at the bar's
# middle; and on a block a meter over the goal's terrace.
title The third floor
spawn 0 1 7
facing 0 0 -1
ambient 0.55
sky 19.45

# The start, a balcony.
kit floor_4  -2 0 4
kit floor_4  2 0 4
kit floor_4  -2 0 8
kit floor_4  2 0 8

# A carousel, 4 m across, 30° a second; the first landing past it.
box 0 -0.15 -1.2   2 0.15 2   spin y 30   color #7a5a3a  name carousel
kit floor_4  0 0 -8.5

# A second, 60° a second, a meter up; the second landing, a meter higher.
box 0 0.85 -14   2 0.15 2   spin y 60   color #7a5a3a  name carousel_2
kit floor_4  0 2 -22.5
kit floor_2  -1 2 -19.5
kit floor_2  1 2 -19.5

# The bar: 10 m long, 30° a second, 2 m up; the third landing, past it.
box 0 1.85 -30   5 0.15 1   spin y 30   color #7a5a3a  name bar
kit floor_4  0 2 -37.5

# Three small turntables, 90° a second, each a meter higher; the goal’s terrace.
box 0 2.85 -43   1 0.15 1   spin y 90   color #7a5a3a  name turntable_1
box 0 3.85 -47   1 0.15 1   spin y -90   color #7a5a3a  name turntable_2
box 0 4.85 -50.5   1 0.15 1   spin y 90   color #7a5a3a  name turntable_3
kit wall_4  -2 3 -52.65
kit wall_4  -2 3 -56.35
kit wall_4  2 3 -52.65
kit wall_4  2 3 -56.35
kit wall_4  -3.85 3 -54.5  rotate y 90
kit wall_4  3.85 3 -54.5  rotate y 90
kit floor_4  -2 6 -54.5
kit floor_4  2 6 -54.5
kit column  3 6 -55
lamp 3 9.6 -55  10 1.6  name beacon

# The stars’ places.
kit platform_2  7 -1 -8.5
kit platform_2  -2.5 6 -55.5
lamp 0 3 -9  7 1
lamp 0 5 -22  7 1
lamp 0 5 -30  8 1
lamp 0 7 -46  7 1

# The land, far below; falling, back to the last checkpoint.
box 0 -40.5 -20   160 0.5 160   color #3d4a36  name land
sensor fall  0 -10 -20   90 2 90
sensor checkpoint  0 0.8 -8.5    2 0.8 2
sensor checkpoint  0 2.8 -22     2 0.8 2
sensor checkpoint  0 2.8 -37.5   2 0.8 2
sensor goal        0 6.8 -54.5   4 0.8 2
sensor star        7 0.8 -8.5    0.6 0.8 0.6
sensor star        0 3.4 -30     0.6 0.6 0.6
sensor star        -2.5 7.8 -55.5  0.6 0.8 0.6
