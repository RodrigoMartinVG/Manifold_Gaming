# Dependencies and generated files
node_modules/
dist/
.astro/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# System and editors
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Local configuration of Claude's tools (the app's launch file, worktrees) stays out; the project's agents are shared.
.claude/*
!.claude/agents/

# The tutorial's libraries (bundled at build time: site/scripts/vendor.mjs)
site/public/vendor/
site/.vendor-entries/

# Local drafts and idea banks (not part of the project)
borradores_ideas/

# Reference books, kept locally (not part of the project)
books/

# Scratch work of either session (stage 5.5d): throwaway tests, probes, notes. Never committed, never in a
# test run's include, never linted.
scratch/

# Each performance run's numbers (stage 5.5d): continuous integration keeps them as an artifact.
perf/results/
